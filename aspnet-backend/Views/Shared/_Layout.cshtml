@using AspnetBackend.Helpers
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - MyApp</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, sans-serif; background: #ffffff; }
  </style>
  <link rel="stylesheet"
    href="https://unpkg.com/@@progress/kendo-theme-default@@latest/dist/all.css" />
</head>
<body>
  <!-- Navigation menu — same on every page, rendered by the base React bundle -->
  <div id="nav"></div>

  <!-- Page-specific content -->
  <main style="padding-top: 56px;">
    @RenderBody()
  </main>

  <!-- Shared webpack chunks (order matters: runtime → vendors → common → base → page) -->
  <script src="@ReactHelper.GetBundlePath(Env, "runtime.js")"></script>
  <script src="@ReactHelper.GetBundlePath(Env, "vendors.js")"></script>
  @if (ReactHelper.HasBundle(Env, "common.js"))
  {
    <!-- common chunk: shared modules used by 2+ page bundles -->
    <script src="@ReactHelper.GetBundlePath(Env, "common.js")"></script>
  }
  <!-- Base bundle: mounts the navigation menu into #nav -->
  <script src="@ReactHelper.GetBundlePath(Env, "base.js")"></script>

  <!-- Page-specific bundle -->
  @RenderSection("Scripts", required: false)
</body>
</html>

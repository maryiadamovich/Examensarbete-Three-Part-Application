@{
    ViewData["Title"] = "Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="padding: 2rem; max-width: 700px; margin: 0 auto;">
  <h1 style="color: #dc2626;">Something went wrong</h1>
  <p style="color: #475569;">An unexpected error occurred. Please try again or contact support.</p>

  <dl style="margin-top: 1.5rem; font-family: monospace; font-size: 0.875rem; color: #475569; line-height: 1.8;">
    <dt style="font-weight: bold; color: #1e293b;">Request ID</dt>
    <dd style="margin: 0 0 0.75rem 0;">@ViewData["RequestId"]</dd>
    @if (ViewData["ErrorPath"] != null)
    {
      <dt style="font-weight: bold; color: #1e293b;">Path</dt>
      <dd style="margin: 0 0 0.75rem 0;">@ViewData["ErrorPath"]</dd>
    }
    @if (ViewData["ErrorMessage"] != null)
    {
      <dt style="font-weight: bold; color: #1e293b;">Message</dt>
      <dd style="margin: 0 0 0.75rem 0;">@ViewData["ErrorMessage"]</dd>
    }
  </dl>
</div>
